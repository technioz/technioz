// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id              String   @id @default(uuid())
  externalId      String?  @unique @map("external_id")
  slug            String   @unique
  title           String
  excerpt         String?
  contentMarkdown String?  @map("content_markdown") @db.Text
  contentHtml     String?  @map("content_html") @db.Text
  metaDescription String?  @map("meta_description")
  category        String   @default("Insights")
  authorName      String   @default("Technioz Team") @map("author_name")
  authorRole      String   @default("Editorial") @map("author_role")
  featured        Boolean  @default(false)
  imageUrl        String?  @map("image_url")
  imageLocalPath  String?  @map("image_local_path")
  imageAlt        String?  @map("image_alt")
  publishedAt     DateTime @default(now()) @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  tags            Tag[]

  @@index([publishedAt])
  @@index([slug])
  @@map("articles")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  articles  Article[]

  @@map("tags")
}

model ContactSubmission {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String
  phone        String?
  companyName  String?  @map("company_name")
  projectType  String?  @map("project_type")
  message      String   @db.Text
  source       String?  // e.g. "contact-page", utm_source, referrer host
  ip           String?
  userAgent    String?  @map("user_agent") @db.Text
  // Comma-joined spam signals (src/lib/honeypot.ts), null when clean. Never used to discard.
  spamReason   String?  @map("spam_reason")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email])
  @@map("contact_submissions")
}

// Leads from paid-ad landing pages (e.g. /ai-saas-development-uae).
// Answer values are the option labels in src/lib/campaign-lead-options.ts.
model CampaignLead {
  id             String   @id @default(uuid())
  fullName       String   @map("full_name")
  email          String
  company        String
  whatsapp       String
  ideaStage      String   @map("idea_stage")
  funding        String
  budget         String
  timeline       String?
  techBackground String?  @map("tech_background")
  decisionRole   String   @map("decision_role")
  idea           String?  @db.Text
  qualified      Boolean
  landingPath    String   @map("landing_path")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  utmContent     String?  @map("utm_content")
  utmTerm        String?  @map("utm_term")
  fbclid         String?
  referrer       String?  @db.Text
  ip             String?
  userAgent      String?  @map("user_agent") @db.Text
  // Comma-joined spam signals (src/lib/honeypot.ts), null when clean. Never used to discard.
  spamReason     String?  @map("spam_reason")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email])
  @@map("campaign_leads")
}
